# Build-Kontext klein halten. Was hier steht, sieht der Daemon gar nicht erst.

# Virtuelle Umgebung. 364 MB mit Windows-Pfaden darin, im Container unbrauchbar.
.venv/
venv/

# Versionsverwaltung und Editor-Kram
.git/
.gitignore
.idea/
.vscode/

# Python-Zwischenstand
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Daten und Indizes. Der Korpus ist urheberrechtlich nicht im Repo, der Index
# wird beim Start eingehaengt statt eingebacken.
data/
logs/
*.log

# Geheimnisse. Gehoert nie in ein Image, auch nicht versehentlich.
.env
.env.local

