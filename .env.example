# Kopieren nach .env und anpassen. .env ist gitignored.
# Stand 19.10.2026: Das sind die Variablen, die der Code tatsaechlich liest.

# Chat-Modell. Siehe gateway/llm.py.
HRPA_MODELL=qwen2.5:14b

# Wie viele Treffer das Retrieval zurueckgibt. Siehe auskunft.py.
HRPA_TREFFER=4

# Antwortweg beim Eval-Lauf: graph, einstufig oder agent. Siehe evals/lauf.py.
HRPA_WEG=graph

# Adresse von Ollama. Wird von der ollama-Bibliothek gelesen, nicht vom Projektcode.
# Im Container zeigt sie auf host.docker.internal oder auf den compose-Dienst.
OLLAMA_HOST=http://localhost:11434
